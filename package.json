{
  "name": "voice-query",
  "version": "1.0.0",
  "private": true,
  "description": "VoiceQuery monorepo orchestrating client and server",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"pnpm server:dev\" \"pnpm client:start\"",
    "client:start": "pnpm --filter @voice-query/client start",
    "client:android": "pnpm --filter @voice-query/client android",
    "client:ios": "pnpm --filter @voice-query/client ios",
    "client:web": "pnpm --filter @voice-query/client web",
    "client:lint": "pnpm --filter @voice-query/client lint",
    "server:dev": "pnpm --filter @voice-query/server dev",
    "server:start": "pnpm --filter @voice-query/server start",
    "prepare": "husky",
    "prepare:termux": "husky && (command -v termux-fix-shebang >/dev/null 2>&1 && termux-fix-shebang .husky/* .husky/_/* 2>/dev/null || true)"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
